# Copy to .env for local development: cp .env.example .env
# Production values are set in the Railway service settings (see docs/DEPLOY.md, written in phase F).

# Postgres (docker compose up -d starts this locally)
DATABASE_URL=postgres://bp:bp@localhost:5432/broker_portal

# API (Fastify)
API_HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Web (Next.js) - where the web server forwards /v1/* and /api/auth/* (SPEC D10)
API_INTERNAL_URL=http://localhost:4000

# Public URL of the web app, used in invite and reset links and by Better Auth
WEB_ORIGIN=http://localhost:3000

# Better Auth - generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# File storage (S3-compatible). Locally: SeaweedFS from docker compose (credentials in docker/seaweedfs/s3.json). On Railway: the Storage Bucket's credentials.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=broker-files
S3_ACCESS_KEY_ID=bp-local-key
S3_SECRET_ACCESS_KEY=bp-local-secret
S3_FORCE_PATH_STYLE=true
# direct = browser uploads with a presigned PUT; proxy = upload through the API (SPEC D11)
STORAGE_UPLOAD_MODE=direct

# Email. Leave RESEND_API_KEY empty to print emails to the API console instead of sending them.
RESEND_API_KEY=
EMAIL_FROM=365 Yachts <onboarding@365yachts.org>

# Owner account created by pnpm db:seed
SEED_OWNER_NAME=Aj
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=change-me-to-a-long-password
# Password for the sample brokers (Daniel Reyes, Kevin Osei) seeded outside production
SEED_SAMPLE_PASSWORD=sample-broker-pass

# WhatsApp support button (SPEC D13). Number in international format, digits only. Empty hides the button.
SUPPORT_CONTACT_NAME=Shelly
SUPPORT_WHATSAPP_NUMBER=15614459241

# Read-only login for broker_metrics, created by pnpm db:metrics-user (SPEC D18). Password: 16+ characters.
METRICS_READER_USER=metrics_login
METRICS_READER_PASSWORD=replace-with-a-long-random-string
