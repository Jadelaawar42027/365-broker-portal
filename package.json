{
  "name": "broker-portal",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@bp/web --filter=@bp/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @bp/web test:e2e",
    "db:generate": "pnpm --filter @bp/db db:generate",
    "db:migrate": "pnpm --filter @bp/db db:migrate",
    "db:seed": "pnpm --filter @bp/db db:seed",
    "db:studio": "pnpm --filter @bp/db db:studio",
    "import:brokers": "pnpm --filter @bp/db import:brokers",
    "db:metrics-user": "pnpm --filter @bp/db db:metrics-user"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "turbo": "^2.11.9",
    "typescript": "~6.0.3"
  }
}
